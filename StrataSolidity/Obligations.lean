import Strata.Languages.Core.Verifier
import Strata.Languages.Core.DDMTransform.FormatCore
import StrataSolidity.SolcAstParser

/-!
# Presenting verification results

Shared by the text, JSON and SARIF outputs, so every format names an
obligation and renders a counterexample the same way.
-/

open Core (VCResult LExprModel)

namespace StrataSolidity.Obligations

/-- Describe a loop-invariant check generated by Core's
    `InsertLoopInvariantAsserts` from its label
    (`insertLoopInvAssert_<kind>_<loop>_<index>[_<label>]`). -/
private def loopCheckDescription? (label : String) : Option String :=
  let invariantIndex (rest : String) : String :=
    -- `<loop>_<index>[_<label>]`, where `<loop>` is `loop_<n>` or `<n>`
    -- (loops numbered from 0 in the procedure).
    let rest := if rest.startsWith "loop_" then (rest.drop 5).toString else rest
    let parts := rest.splitOn "_"
    let loop := match parts.head? |>.bind String.toNat? with
      | some n => s!" of loop {n + 1}"
      | none => ""
    match parts.drop 1 |>.head? |>.bind String.toNat? with
    | some i => s!" #{i + 1}{loop}"
    | none => loop
  let after (pre : String) : Option String :=
    if label.startsWith pre then some (label.drop pre.length).toString else none
  match after "insertLoopInvAssert_entry_invariant_" with
  | some rest => some s!"loop invariant{invariantIndex rest} holds on entry"
  | none =>
  match after "insertLoopInvAssert_arbitrary_iter_maintain_invariant_" with
  | some rest => some s!"loop invariant{invariantIndex rest} is preserved by the loop body"
  | none =>
  if label.startsWith "insertLoopInvAssert_measure_lb_" then some "loop measure is non-negative"
  else if label.startsWith "insertLoopInvAssert_measure_decrease_" then some "loop measure decreases"
  else none

/-- Human-readable name of an obligation: the property summary attached by
    the translator or by Laurel (`ensures x == val`, `invariant #1`,
    `modifies frame (y)`, `divisor is non-zero`, …), else a description of a
    generated loop-invariant check, else `assert` for a user `assert(…)`,
    else the raw label. -/
def name (vcr : VCResult) (source? : Option (String × String) := none) : String :=
  let label := vcr.obligation.label
  match vcr.obligation.metadata.getPropertySummary with
  | some "modifies clause" => "heap frame (only this contract is modified)"
  | some s => s
  | none =>
    match loopCheckDescription? label with
    | some d => d
    | none =>
      if label.startsWith "assert(" then
        -- The assertion as written, when it is in the user's file.
        match Imperative.getFileRange vcr.obligation.metadata, source? with
        | some { file := .file path, range }, some (srcPath, src) =>
          if path == srcPath && !range.isNone then
            String.fromUTF8! (src.toUTF8.extract range.start.byteIdx range.stop.byteIdx)
          else "assert"
        | _, _ => "assert"
      else label

/-- Translator temporaries for evaluation order (`__k3_0`, `__old5`,
    `__rhs7`), which are not Solidity variables. -/
def isTemporary (name : String) : Bool :=
  ["__k", "__old", "__rhs"].any fun p =>
    name.startsWith p && (((name.drop p.length).toString.toList.head?).map Char.isDigit).getD false

/-- The value an internal call returned, held in the temporary
    `__ret<byte offset of the call>_<i>`, named after the call's line in
    `source?`: `result of the call at line 11`. -/
def callResultName? (source? : Option String) (name : String) : Option String := do
  guard (name.startsWith "__ret")
  let (off, i) ← match ((name.drop 5).toString.splitOn "_") with
    | [o, i] => do pure (← o.toNat?, ← i.toNat?)
    | _ => none
  let line := match source? with
    | some src => s!" at line {(Lean.FileMap.ofString src).toPosition ⟨off⟩ |>.line}"
    | none => ""
  pure s!"result{if i == 0 then "" else s!" {i + 1}"} of the call{line}"

/-- Display name of a model variable: drops the SSA suffix (`x@3`) and
    undoes the translator's renamings, applied only to the names it
    introduces (`inputs` are the input names of the procedures): the input
    `x_param` is the parameter `x`, the input `x_in` is the pre-state value
    `old(x)`, and `msg_sender` is `msg.sender`. -/
def displayVarName (inputs : Std.HashSet String) (raw : String) : String :=
  let s := match raw.splitOn "@" with
    | base :: _ :: _ => base
    | _ => raw
  let s := if s.startsWith "self." then (s.drop 5).toString else s
  let s :=
    if s == "msg_sender" then "msg.sender"
    else if s == "msg_value" then "msg.value"
    else if s.endsWith "_param" && inputs.contains s then (s.dropEnd 6).toString
    else if s.endsWith "_in" && inputs.contains s then s!"old({(s.dropEnd 3).toString})"
    else s
  Strata.Solidity.SolcAst.unmangleName s

/-- A model value as Solidity would write it: `-6`, not `int.neg(6)`. -/
private def displayValue (v : String) : String :=
  match v.splitOn "int.neg(" with
  | [_] => v
  | first :: rest =>
    first ++ String.join (rest.map fun part =>
      match part.splitOn ")" with
      | digits :: tail => if !digits.isEmpty && digits.all Char.isDigit then
          "-" ++ digits ++ ")".intercalate tail
        else "int.neg(" ++ part
      | [] => "int.neg(")
  | [] => v

/-- Variables connected to the obligation: its free variables, closed under
    "occurs in a path condition together with a connected variable". These
    are the model entries that say something about this obligation; Core asks
    the solver for every variable of the shared SMT environment, including
    other procedures' variables. -/
private def relevantVars (vcr : VCResult) : Std.HashSet String := Id.run do
  let ob := vcr.obligation
  let names (e : Core.Expression.Expr) : List String :=
    (Lambda.LExpr.freeVars e).map (toString ·.1)
  -- The variables of each path-condition entry, as one group.
  let groups : List (List String) := ob.assumptions.flatten.map fun
    | .assumption _ e => names e
    | .varDecl x _ (.det e) => toString x :: names e
    | .varDecl x _ .nondet => [toString x]
    | .distinct _ es => es.flatMap names
  let mut vars : Std.HashSet String := Std.HashSet.ofList (names ob.obligation)
  -- Fixpoint: each round adds the groups that touch the current set.
  let mut changed := true
  let mut fuel := groups.length + 1
  while changed && fuel > 0 do
    changed := false
    fuel := fuel - 1
    for g in groups do
      if g.any vars.contains && !g.all vars.contains then
        vars := vars.insertMany g
        changed := true
  return vars

/-- The user-relevant part of a counterexample as `(name, value)` pairs.
    Translator-internal variables (`$heap`, `$cndtn_*`, `self`, call
    temporaries, …) are hidden and values are rendered with Core's
    expression printer. `inputs` are the procedures' input names (see
    `displayVarName`). -/
def counterexample (vcr : VCResult) (inputs : Std.HashSet String := {})
    (source? : Option String := none) : List (String × String) :=
  let relevant := relevantVars vcr
  vcr.lexprModel.filterMap fun (id, e) =>
    let raw := toString id
    let base := (raw.splitOn "@").head!
    if base.startsWith "$" || base == "self" || isTemporary base || !relevant.contains raw then none
    else
      let name := (callResultName? source? base).getD (displayVarName inputs raw)
      some (name, displayValue (toString (Strata.Core.formatExprs [e])))

end StrataSolidity.Obligations
